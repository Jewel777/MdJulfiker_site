@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Contact";
}

<div class="contact-content">
    <h2 class="text-center fw-bold mb-4 text-warning border-bottom pb-2">Contact Me</h2>

    <!-- Contact Info Card -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8" style="perspective: 1000px;">
            <div class="contact-card">
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-envelope-fill text-warning me-2"></i>
                        Email: <a href="mailto:jewelsheikh2013@gmail.com" class="contact-link" aria-label="Email">jewelsheikh2013@gmail.com</a>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
                        Location: <span class="contact-text">Charleston, WV, USA</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-linkedin text-warning me-2"></i>
                        LinkedIn: <a href="https://www.linkedin.com/in/md-julfiker-ali-jewel-7b1442a9/" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="LinkedIn">Visit Profile</a>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-github text-warning me-2"></i>
                        GitHub: <a href="https://github.com/Jewel777" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="GitHub">github.com/Jewel777</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["SuccessMessage"] is string sm && !string.IsNullOrEmpty(sm))
            {
                <div class="alert alert-success text-center mt-0 mb-4" role="alert">
                    @sm
                </div>
            }
            @if (TempData["ErrorMessage"] is string em && !string.IsNullOrEmpty(em))
            {
                <div class="alert alert-danger text-center mt-0 mb-4" role="alert">
                    @em
                </div>
            }
        </div>
    </div>

    <!-- Contact Form -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-5 shadow-lg border-0 rounded-4 bg-dark text-light">
                <h3 class="text-warning text-center mb-4">Send Me a Message</h3>

                <form asp-controller="Home" asp-action="Contact" method="post" id="contactForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="_subject" value="New Portfolio Contact" />
                    <input type="hidden" name="_template" value="table" />
                    <input type="hidden" name="_captcha" value="false" />

                    <div class="mb-4">
                        <label for="Name" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" required maxlength="100" placeholder="Enter your name" autocomplete="name" />
                    </div>

                    <div class="mb-4">
                        <label for="Email" class="form-label">Email Address</label>
                        <input type="email" class="form-control" id="Email" name="Email" required maxlength="254" placeholder="Enter your email" autocomplete="email" />
                    </div>

                    <div class="mb-4">
                        <label for="Message" class="form-label">Your Message</label>
                        <textarea class="form-control" id="Message" name="Message" rows="6" required maxlength="5000" placeholder="Write your message"></textarea>
                    </div>

                    <!-- Honeypot: must be named "Website" to match controller -->
                    <div class="d-none" aria-hidden="true">
                        <label for="Website">Website</label>
                        <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
                        <label for="ContactHoney">Leave this field empty</label>
                        <input type="text" id="ContactHoney" name="_honey" tabindex="-1" autocomplete="off" />
                    </div>

                    <div id="contactStatus" class="alert d-none text-center" role="status" aria-live="polite"></div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-warning btn-lg px-5" id="sendBtn">
                            ✉️ Send Message
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles for Contact Page -->
<style>
    .contact-card {
        background-color: #1a1a1a;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(255, 106, 0, 0.25);
        color: #f1f1f1;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }
    .contact-card:hover {
        transform: rotateX(5deg) rotateY(5deg) scale(1.03);
        box-shadow: 0 14px 28px rgba(255, 106, 0, 0.5);
        z-index: 10;
        position: relative;
    }
    .contact-link { color: #ff944d; text-decoration: none; }
    .contact-link:hover { text-decoration: underline; color: #ffc107; }
    .contact-text { color: #ccc; }
    .card {
        background: linear-gradient(145deg, #1e1e2f, #2a2a3b);
        box-shadow: 0 10px 20px rgba(255, 165, 0, 0.2);
    }
    .form-control {
        background-color: #2c2c3c;
        color: #fff;
        border: 1px solid #555;
    }
    .form-control:focus {
        background-color: #2c2c3c;
        color: #fff;
        border-color: #ffa726;
        box-shadow: 0 0 5px #ffa726;
    }
    .contact-link { overflow-wrap: anywhere; }
    @@media (max-width: 576px) {
        .contact-content { margin: 0; }
        #contact .container.py-5 { padding: 1rem .5rem !important; }
        #contact .glass.p-4 { padding: 1rem !important; }
        .contact-card { padding: 20px 18px; }
        #contact .card { padding: 24px 18px !important; }
        #contact .container { --bs-gutter-x: 1rem; }
        #contact h2, #contact h3 { overflow-wrap: anywhere; }
        #sendBtn { width: 100%; padding-inline: 1rem !important; }
    }
    @@media (hover: none), (prefers-reduced-motion: reduce) {
        .contact-card:hover { transform: none; }
    }
</style>

<script>
(function () {
  const form = document.getElementById('contactForm');
  const btn  = document.getElementById('sendBtn');

  if (!form || !btn) return;

  const status = document.getElementById('contactStatus');

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!form.reportValidity()) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';

    if (status) {
      status.className = 'alert d-none text-center';
      status.textContent = '';
    }

    try {
      const response = await fetch('https://formsubmit.co/ajax/jewelsheikh2013@gmail.com', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      });

      if (!response.ok) throw new Error('Delivery service rejected the message.');

      form.reset();
      if (status) {
        status.className = 'alert alert-success text-center';
        status.textContent = 'Thank you! Your message has been sent.';
      }
    } catch (error) {
      if (status) {
        status.className = 'alert alert-danger text-center';
        status.innerHTML = 'Sorry—your message could not be sent. Please email <a href="mailto:jewelsheikh2013@gmail.com" class="alert-link">jewelsheikh2013@gmail.com</a> directly.';
      }
    } finally {
      btn.disabled = false;
      btn.textContent = '✉️ Send Message';
    }
  });
})();
</script>

