@{
    ViewData["Title"] = "Analytics Login";
}

<div class="container py-5" style="max-width: 34rem;">
    <div class="card p-4 shadow border-0 rounded-4 bg-dark text-light">
        <h1 class="h3 text-warning mb-3">Analytics Login</h1>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <form method="post" action="/admin/analytics-login">
            @Html.AntiForgeryToken()
            <label for="key" class="form-label">Analytics key</label>
            <input id="key" name="key" type="password" class="form-control mb-3" required autocomplete="current-password" />
            <button type="submit" class="btn btn-warning">Sign in</button>
        </form>
    </div>
</div>
