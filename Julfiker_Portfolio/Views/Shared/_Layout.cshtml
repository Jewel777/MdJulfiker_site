<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Md Julfiker Ali Jewel, featuring secure .NET engineering, cybersecurity and AI research, publications, projects, and professional experience." />
    <meta name="theme-color" content="#f2f0f4" />
    <script>
      (function () {
        try {
          var saved = localStorage.getItem('portfolio-theme');
          var theme = saved === 'dark' || saved === 'light'
            ? saved
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) { document.documentElement.setAttribute('data-theme', 'light'); }
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Md Julfiker Ali Jewel — Software Engineer, Cybersecurity & AI" />
    <meta property="og:description" content="Portfolio of Md Julfiker Ali Jewel: secure .NET systems, cybersecurity, AI research, publications, and projects." />
    <meta property="og:url" content="https://www.mdjulfikeralijewel.com/" />
    <meta property="og:image" content="https://www.mdjulfikeralijewel.com/images/Julfiker-portrait-v2.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://www.mdjulfikeralijewel.com/" />
    <title>@ViewData["Title"] - Md Julfiker Ali Jewel Portfolio</title>

    <!-- 🔧 Early sanitizer: strip ?ac=... but keep any #hash -->
    <script>
    (function () {
      try {
        var url = new URL(window.location.href);
        if (url.searchParams.has('ac')) {
          url.searchParams.delete('ac');
          var cleaned = url.toString().replace(/\?$/, '');
          history.replaceState(null, '', cleaned);
        }
      } catch (e) { /* no-op */ }
    })();
    </script>

    <!-- Bootstrap -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css?v=1" rel="stylesheet" />
    <!-- Icons / Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Site CSS -->
    <link href="~/css/site.css?v=29" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- JSON-LD (Razor @@ escapes) -->
    <script type="application/ld+json">
    {
      "@@context":"https://schema.org",
      "@@type":"Person",
      "name":"Md Julfiker Ali Jewel",
      "url":"https://www.mdjulfikeralijewel.com",
      "image":"https://www.mdjulfikeralijewel.com/images/Julfiker-portrait-v2.png",
      "jobTitle":"Software Programmer Analyst",
      "worksFor":{"@@type":"Organization","name":"West Virginia Department of Health and Human Resources"},
      "sameAs":[
        "https://www.linkedin.com/in/md-julfiker-ali-jewel-7b1442a9/",
        "https://x.com/JewelShaikh2",
        "https://github.com/Jewel777",
        "https://www.youtube.com/@@nongor3694",
        "https://scholar.google.com/citations?user=KYHGDlgAAAAJ",
        "https://orcid.org/0009-0004-8799-8957"
      ]
    }
    </script>

    @RenderSection("Styles", required: false)
</head>

<body class="liquid-body">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="scroll-progress" aria-hidden="true"><span id="scrollProgress"></span></div>
    <!-- Spinner -->
    <div id="loading-spinner" class="spinner-wrapper">
        <div class="spinner"></div>
    </div>

    <!-- Particles backdrop -->
    <div id="particles-js"></div>

    <!-- Navbar -->
    <nav id="mainNavbar" class="navbar navbar-expand-lg navbar-dark fixed-top glass-navbar">
        <div class="container-fluid">
            <!-- ✅ Brand participates in smooth scroll + active highlight -->
            <a class="navbar-brand fw-bold text-warning" href="/#home" data-nav="home" aria-label="Md Julfiker Ali Jewel — Home">
                <span class="brand-mark">MJ</span><span class="brand-name">Julfiker Ali Jewel</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
                <ul class="navbar-nav text-center">
                    <li class="nav-item"><a class="nav-link" href="/#home"            data-nav="home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#skills"          data-nav="skills">Skills</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#education"       data-nav="education">Education</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#experience"      data-nav="experience">Experience</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#publications"    data-nav="publications">Publications</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#accomplishments" data-nav="accomplishments">Accomplishments</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#projects"        data-nav="projects">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#research"        data-nav="research">Research</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#resume"          data-nav="resume">Resume</a></li>
                    <li class="nav-item">
                        <button id="finderTrigger" class="finder-trigger" type="button" aria-haspopup="dialog" aria-controls="portfolioFinder">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <span>Explore</span>
                            <kbd>Ctrl K</kbd>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
                            <i class="bi bi-moon-stars-fill theme-icon-dark" aria-hidden="true"></i>
                            <i class="bi bi-sun-fill theme-icon-light" aria-hidden="true"></i>
                            <span class="theme-label">Night</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <a class="nav-contact ms-2" href="/#contact" data-nav="contact">📩 Contact</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main -->
    <main id="main-content" class="main-content container-fluid px-3 px-md-4" tabindex="-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="glass-footer text-center py-3 mt-5">
        <div class="container">
            &copy; 2026 Md Julfiker Ali Jewel | <a href="/#privacy" class="footer-link">Privacy Policy</a>
        </div>
    </footer>

    <button id="backToTop" class="back-to-top" type="button" aria-label="Back to top">
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
    </button>

    <dialog id="portfolioFinder" class="portfolio-finder" aria-labelledby="finderTitle">
        <div class="finder-shell">
            <div class="finder-header">
                <div>
                    <span class="finder-eyebrow">Portfolio command center</span>
                    <h2 id="finderTitle">Where would you like to go?</h2>
                </div>
                <button id="finderClose" class="finder-close" type="button" aria-label="Close portfolio explorer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <label class="finder-search" for="finderInput">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="finderInput" type="search" autocomplete="off" placeholder="Search projects, research, experience…" />
                <kbd>Esc</kbd>
            </label>
            <p id="finderStatus" class="finder-status" aria-live="polite">Choose a destination or start typing.</p>
            <nav class="finder-results" aria-label="Portfolio destinations">
                <a href="/#experience" data-finder-keywords="career work dotnet government programmer analyst employment">
                    <span class="finder-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span><span><strong>Professional experience</strong><small>Public-sector engineering and technical roles</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#projects" data-finder-keywords="portfolio code github python rails applications software projects">
                    <span class="finder-icon"><i class="bi bi-grid-1x2" aria-hidden="true"></i></span><span><strong>Selected projects</strong><small>Software, ML, systems, and UX work</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#research" data-finder-keywords="artificial intelligence machine learning cybersecurity flood prosthetics llm research">
                    <span class="finder-icon"><i class="bi bi-cpu" aria-hidden="true"></i></span><span><strong>Research experience</strong><small>AI, cybersecurity, forecasting, and embedded systems</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#publications" data-finder-keywords="papers articles springer ieee abstracts scholar publications writing">
                    <span class="finder-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span><strong>Publications</strong><small>Peer-reviewed work and publication abstracts</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#skills" data-finder-keywords="skills technologies csharp dotnet sql python machine learning security tools">
                    <span class="finder-icon"><i class="bi bi-tools" aria-hidden="true"></i></span><span><strong>Technical capabilities</strong><small>Engineering, data, security, and AI toolkit</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#education" data-finder-keywords="degrees university masters bachelors courses advisors education">
                    <span class="finder-icon"><i class="bi bi-mortarboard" aria-hidden="true"></i></span><span><strong>Education</strong><small>Graduate study, coursework, and academic background</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#resume" data-finder-keywords="cv pdf download preview resume">
                    <span class="finder-icon"><i class="bi bi-file-earmark-person" aria-hidden="true"></i></span><span><strong>Resume</strong><small>Preview, open, or download the latest PDF</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/#contact" data-finder-keywords="email linkedin message collaboration hire contact">
                    <span class="finder-icon"><i class="bi bi-send" aria-hidden="true"></i></span><span><strong>Contact</strong><small>Start a conversation or propose a collaboration</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </nav>
            <div class="finder-footer"><span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span><span><kbd>Enter</kbd> Open</span><span><kbd>Esc</kbd> Close</span></div>
        </div>
    </dialog>

    <!-- JS libs -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js?v=1"></script>

    <!-- ✅ Defer heavy libs -->
    <script defer src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>

    <!-- ✅ Single controller for spinner + particles + typed + counters -->
    <script defer src="~/js/site.js?v=21"></script>

    <!-- Keep accomplishments filter -->
    <script defer src="~/js/filters.js?v=4"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

